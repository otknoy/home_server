{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "reviewers": ["otknoy"],
  "assignAutomerge": true,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "ignorePaths": [
    "**/upstream/**"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/otknoy/roomctl"],
      "versioning": "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})(?<build>\\d{6})$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^k8s/manifest/update-upstream-manifests\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+\\w+=(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/yamlfmt\\.yaml$/"
      ],
      "matchStrings": [
        "go install github\\.com/google/yamlfmt/cmd/yamlfmt@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/google/yamlfmt",
      "datasourceTemplate": "go"
    }
  ]
}
